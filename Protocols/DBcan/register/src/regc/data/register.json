{
    "$ref": "#/definitions/group",
    "definitions": {
        "primitive": {
            "type": "object",
            "properties": {
                "name":         { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32,
                                  "description": "Register name. For dtype:enum registers the name must be unique across the entire map (it prefixes the generated C value constants). Enforced by the compiler, not this schema." },
                "dtype":        { "type": "string", "enum": ["bool", "uint", "int", "float", "string", "enum", "struct"] },
                "bits":         { "type": "integer", "minimum": 1 },
                "array_size":   { "type": "integer", "minimum": 1, "default": 0 }, 
                "min_value":    { "type": "number" },
                "max_value":    { "type": "number" },
                "resolution":   { "type": "number", "default": 1},
                "units":        { "type": "string" },
                "offset":       { "type": "number" },
                "default":      { "type": ["number", "boolean", "string"], "default": 0 },
                "persist":      { "type": "boolean", "default": false },
                "errors":       {
                    "type": "array",
                    "description": "Per-register error names. The compiler assigns codes (>= 64) by index; the author never writes a code.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name":        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                            "description": { "type": "string" }
                        },
                        "required": ["name"],
                        "additionalProperties": false
                    }
                },
                "description":  { "type": "string" },
                "values":       {
                    "anyOf": [
                        {
                            "type": "object",
                            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                            "additionalProperties": { "type": "integer", "minimum": 0 },
                            "minProperties": 1
                        },
                        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
                                    "dtype":      { "type": "string", "enum": ["bool", "uint", "int", "float", "enum"] },
                                    "bits":       { "type": "integer", "minimum": 1 },
                                    "resolution": { "type": "number", "default": 1 },
                                    "units":      { "type": "string" },
                                    "offset":     { "type": "number", "default": 0 },
                                    "values": {
                                        "anyOf": [
                                            {
                                                "type": "object",
                                                "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
                                                "additionalProperties": { "type": "integer", "minimum": 0 },
                                                "minProperties": 1
                                            },
                                            { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                                        ]
                                    }
                                },
                                "required": ["name", "dtype", "bits"],
                                "additionalProperties": false
                            }
                        }
                    ]
                }
            },
            "required": ["name"],
            "allOf": [
                {
                    "if": {
                        "properties": { "dtype": { "enum": ["uint", "int", "float", "string", "enum"] } },
                        "required": ["dtype"]
                    },
                    "then": {
                        "required": ["bits"]
                    }
                },
                {
                    "if": {
                        "properties": { "dtype": { "enum": ["enum", "struct"] } },
                        "required": ["dtype"]
                    },
                    "then": {
                        "required": ["values"]
                    }
                }
            ],
            "additionalProperties": false
        },
        "group": {
            "type": "object",
            "properties": {
                "name":     { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32},
                "count":    { "type": "integer", "minimum": 1, "default": 1,
                              "description": "How many copies of this group exist. Only meaningful with base -- repeating an auto-numbered group would shift every register after it." },
                "base":     { "type": "integer", "minimum": 0,
                              "description": "Pins this group's first register number instead of taking it from the walk. Copies are laid out base + i*stride, where stride is the group's register count, so count may vary per node without moving anything else." },
                "overrides":{ "type": "object",
                              "description": "Board maps only: adjusts a pinned group in the global map. Keyed by full dotted path; only count may be set.",
                              "additionalProperties": {
                                  "type": "object",
                                  "properties": { "count": { "type": "integer", "minimum": 1 } },
                                  "required": ["count"],
                                  "additionalProperties": false
                              } },
                "permissions":  { "type": "string", "enum": ["R", "W", "RW", "CMD", "ANY"] },
                "description":  { "type": "string",
                                  "description": "What this group is for as a unit -- effect, timing, and interactions a caller needs. Not hashed, so it can be improved without invalidating deployed maps." },
                "children": { "type": "array" }
            },
            "required": ["name", "permissions", "children"],
            "allOf": [
                {
                    "if": {
                        "properties": { "permissions": { "const": "CMD" } },
                        "required": ["permissions"]
                    },
                    "then": { "properties": { "children": { "items": { "oneOf": [
                        { "$ref": "#/definitions/group" },
                        { "$ref": "#/definitions/primitive" }
                    ]}}}},
                    "else": { "properties": { "children": { "items": { "oneOf": [
                        { "$ref": "#/definitions/group" },
                        { "allOf": [ { "$ref": "#/definitions/primitive" }, { "required": ["dtype"] } ] }
                    ]}}}}
                }
            ],
            "additionalProperties": false
        }
    }
}
