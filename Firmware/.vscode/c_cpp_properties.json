{
  "version": 4,
  "configurations": [
    {
      "name": "STM32G474",
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": [
        "-mcpu=cortex-m4",
        "-mfpu=fpv4-sp-d16",
        "-mfloat-abi=hard",
        "-mthumb"
      ],
      "includePath": [
        "${workspaceFolder}/../Protocols/DBcan/core/inc",
        "${workspaceFolder}/../Protocols/DBcan/transports/inc",
        "${workspaceFolder}/../Protocols/DBcan/Bootloader/drivers/inc",
        "${workspaceFolder}/Boards/BLDC/Core/Inc",
        "${workspaceFolder}/Boards/BLDC/Inc",
        "${workspaceFolder}/Boards/BLDC/Drivers/STM32G4xx_HAL_Driver/Inc",
        "${workspaceFolder}/Boards/BLDC/Drivers/STM32G4xx_HAL_Driver/Inc/Legacy",
        "${workspaceFolder}/Boards/BLDC/Drivers/CMSIS/Device/ST/STM32G4xx/Include",
        "${workspaceFolder}/Boards/BLDC/Drivers/CMSIS/Include"
      ],
      "defines": [
        "STM32G474xx",
        "USE_HAL_DRIVER"
      ],
      "cStandard": "c11",
      "intelliSenseMode": "linux-gcc-arm"
    }
  ]
}
